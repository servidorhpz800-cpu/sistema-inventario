-- Se agrega cada columna por separado para no depender de columnas creadas
-- anteriormente en el mismo ALTER TABLE. Se pueden volver a ejecutar.
ALTER TABLE reportes ADD COLUMN IF NOT EXISTS total DECIMAL(12, 2) DEFAULT NULL;
ALTER TABLE reportes ADD COLUMN IF NOT EXISTS saldo DECIMAL(12, 2) DEFAULT NULL;
ALTER TABLE reportes ADD COLUMN IF NOT EXISTS nombre_servicio VARCHAR(150) DEFAULT NULL;
ALTER TABLE reportes ADD COLUMN IF NOT EXISTS plan_cliente VARCHAR(150) DEFAULT NULL;
ALTER TABLE reportes ADD COLUMN IF NOT EXISTS ip_cliente VARCHAR(45) DEFAULT NULL;
ALTER TABLE reportes ADD COLUMN IF NOT EXISTS firma_cliente VARCHAR(255) DEFAULT NULL;

-- Ajuste de tipos de orden para reflejar las nuevas opciones del flujo de tienda.
-- Mantiene compatibilidad con valores antiguos (retiro, recogida, revision).
ALTER TABLE ordenes
    MODIFY tipo_orden ENUM('retirar_equipo', 'instalacion', 'cambio_domicilio', 'cambio_contrasena', 'reporte', 'retiro', 'recogida', 'revision') NOT NULL;

-- Agrega el motivo obligatorio de cancelación a las órdenes.
ALTER TABLE ordenes
    ADD COLUMN IF NOT EXISTS motivo_cancelacion TEXT DEFAULT NULL AFTER descripcion;

-- Equipos de técnicos que comparten el inventario de módems por vehículo.
UPDATE usuarios SET equipo = 'Coche Blanco' WHERE usuario IN ('dario', 'joshua') AND rol = 'tecnico';
UPDATE usuarios SET equipo = 'Camioneta Azul' WHERE usuario IN ('kevin', 'jorge') AND rol = 'tecnico';

-- Verifica que las asignaciones de vehículo estén correctas:
SELECT usuario, nombre, equipo
FROM usuarios
WHERE usuario IN ('dario', 'joshua', 'kevin', 'jorge')
ORDER BY equipo, usuario;

